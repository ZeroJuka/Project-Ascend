{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-native",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "types": ["react", "react-native", "expo"]
  },
  "include": ["src", "index.ts"],
  "exclude": ["node_modules"]
}
